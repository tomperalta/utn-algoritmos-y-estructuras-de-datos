<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="TP1 - Home Banking Mesopotamia" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/TP1" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
					<Add option="-std=c++17" />
					<Add option="-Wall" />
					<Add option="-Wextra" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/TP1" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-std=c++17" />
					<Add option="-Wall" />
					<Add option="-Wextra" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-std=c++17" />
			<Add option="-Wall" />
			<Add option="-Wextra" />
		</Compiler>
		<!-- Unica unidad de compilacion: incluye a todos los .hpp del proyecto.
		     Los encabezados figuran abajo para poder abrirlos desde el arbol,
		     con compile="0" para que Code::Blocks no intente compilarlos. -->
		<Unit filename="trabajo-practico-1.cpp">
